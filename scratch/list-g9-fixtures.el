(require 'edgar-forms)
(require 'edgar-fixtures)
(let* ((forms (edgar-forms-by-family "G9 Periodic & event narrative"))
       (slugs (edgar-fixtures-slugs)))
  (dolist (form forms)
    (let ((name (car form))
          (info (cdr form))
          fixtures)
      (dolist (slug slugs)
        (let ((filing (edgar-fixtures-filing slug)))
          (when (equal name (plist-get filing :form))
            (push slug fixtures))))
      (princ (format "%s\t%s\t%d\t%s\n"
                     name (plist-get info :level) (plist-get info :volume)
                     (string-join (nreverse fixtures) ","))))))
